# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Windows-style newlines with a newline ending every file
[*]
end_of_line = crlf
insert_final_newline = true

[!*.md]
trim_trailing_whitespace = true

[*.sh]
end_of_line = lf

[*.toml]
charset = utf-8
indent_style = space
indent_size = 2

[*.py]
charset = utf-8
indent_style = space
indent_size = 4
